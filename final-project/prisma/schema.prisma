// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// USER + NEXTAUTH STRUCTURE
// =========================================================

model User {
  id            String    @id @default(cuid())
  userID        String?   @unique
  name          String
  email         String?
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete flag for user accounts
  isDeleted Boolean @default(false)

  // Remember user's last chosen wallet
  defaultWalletId String?
  defaultWallet   Wallet? @relation("DefaultWallet", fields: [defaultWalletId], references: [id])

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  walletUsers         WalletUser[]
  pinnedWallets       UserPinnedWallet[]
  createdTransactions Transaction[]      @relation("UserCreatedTransactions")
  transactionPayers   TransactionPayer[]
  transactionShares   TransactionShare[]
  notifications       Notification[]
  tags                Tag[]              @relation("UserCreatedTags")
  subscriptions       Subscription[]
  deviceCarriers      DeviceCarrier[]

  @@index([userID])
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// =========================================================
// WALLET STRUCTURE
// =========================================================

model Wallet {
  id              String   @id @default(cuid())
  name            String
  defaultCurrency String   @default("TWD")
  description     String?  @db.Text
  note            String?  @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Soft delete flag for wallets
  isDeleted Boolean @default(false)

  members       WalletUser[]
  pinnedByUsers UserPinnedWallet[]
  transactions  Transaction[]
  subscriptions Subscription[]

  // reverse relation for default wallet
  defaultUsers User[] @relation("DefaultWallet")
}

model WalletUser {
  id String @id @default(cuid())

  walletId String
  userId   String
  role     WalletRole       @default(MEMBER)
  status   WalletUserStatus @default(OWNER)

  // Soft delete flag for wallet membership records
  isDeleted Boolean @default(false)

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([walletId, userId])
}

model UserPinnedWallet {
  id String @id @default(cuid())

  userId   String
  walletId String
  order    Int    @default(0) // Order for displaying pinned wallets

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([userId, walletId])
  @@index([userId])
  @@index([userId, order])
}

enum WalletRole {
  OWNER
  MEMBER
  VIEWER
}

enum WalletUserStatus {
  OWNER
  PENDING
  ACCEPTED
  REJECTED
}

// =========================================================
// TAGS 
// =========================================================

model Tag {
  id   String  @id @default(cuid())
  name String  @unique
  type TagType @default(EXPENSE)

  // system user or normal user (NOT NULL)
  createdBy String
  createdAt DateTime @default(now())

  // Soft delete flag for tags
  isDeleted Boolean @default(false)

  // Icon identifier key for tag visualization
  // Stores the icon key (e.g., "shopping-cart", "coffee")
  // Rendered by frontend icon library
  iconKey String @default("tag")

  creator User @relation("UserCreatedTags", fields: [createdBy], references: [id])

  transactions  Transaction[]
  subscriptions Subscription[]
}

enum TagType {
  EXPENSE
  INCOME
}

// =========================================================
// TRANSACTIONS
// =========================================================

model Transaction {
  id          String @id @default(cuid())
  walletId    String
  createdById String

  date      DateTime
  amount    Float
  currency  String
  rateToNTD Float?
  name      String?  @db.Text
  note      String?  @db.Text

  // Soft delete flag for transactions
  isDeleted Boolean @default(false)

  type TransactionType @default(EXPENSE)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet    Wallet @relation(fields: [walletId], references: [id])
  createdBy User   @relation("UserCreatedTransactions", fields: [createdById], references: [id])

  payers                TransactionPayer[]
  shares                TransactionShare[]
  subscriptionHistories SubscriptionHistory[]
}

model TransactionPayer {
  id            String @id @default(cuid())
  transactionId String
  payerId       String
  paidAmount    Float

  transaction Transaction @relation(fields: [transactionId], references: [id])
  payer       User        @relation(fields: [payerId], references: [id])
}

model TransactionShare {
  id            String @id @default(cuid())
  transactionId String
  userId        String
  shareAmount   Float

  transaction Transaction @relation(fields: [transactionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

// =========================================================
// SUBSCRIPTION + EXECUTION HISTORY
// =========================================================

model Subscription {
  id       String @id @default(cuid())
  walletId String
  userId   String
  

  amount         Float
  currency       String
  nextBilling    DateTime
  intervalMonths Float    @default(1)

  startDate DateTime
  endDate   DateTime?
  type      TransactionType @default(EXPENSE)
  tagId     String
  name      String?

  // Soft delete flag for subscriptions
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  histories SubscriptionHistory[]
}

model SubscriptionHistory {
  id             String        @id @default(cuid())
  subscriptionId String
  transactionId  String?
  status         BillingStatus @default(SUCCESS)
  message        String?       @db.Text
  runAt          DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  transaction  Transaction? @relation(fields: [transactionId], references: [id])
}

enum BillingStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum TransactionType {
  INCOME
  EXPENSE
}

// =========================================================
// NOTIFICATION
// =========================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Soft delete flag for notifications
  isDeleted Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  REPAYMENT
  SUBSCRIPTION_REMINDER
  SHARED_WALLET_UPDATE
  WALLET_INVITATION
}

// =========================================================
// DEVICE CARRIER (載具)
// =========================================================

model DeviceCarrier {
  id          String @id @default(cuid())
  userId      String
  carrierCode String

  // Soft delete flag for device carriers
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
